{
  "name": "angular-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Angular edition of the E62/C62 sensor dashboard demo",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build --base-href ./",
    "desktop": "electron .",
    "package:windows": "pnpm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.2"
  },
  "build": {
    "appId": "tw.com.e62.dashboard.angular.demo",
    "productName": "E62 Angular Dashboard Demo",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/angular-dashboard/browser/**/*", "electron/**/*", "package.json"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "E62-Angular-Dashboard-Demo-${version}-Windows-${arch}.${ext}"
    }
  }
}
